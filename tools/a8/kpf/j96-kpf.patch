diff --git i/checkra1n/kpf/j96_page5_capture.c w/checkra1n/kpf/j96_page5_capture.c
new file mode 100644
index 0000000..1aaa0aa
--- /dev/null
+++ w/checkra1n/kpf/j96_page5_capture.c
@@ -0,0 +1,180 @@
+/*
+ * J96 (iPad mini 4, A8/T7000, iPadOS 15.8.3 19H386) full-state planned-panic
+ * KPF component (this PongoOS checkout's kpf.h API).
+ *
+ * Two hooks, read-only (no MMIO store):
+ *   capture  ApplePMGR ps-poll `blr x8` (0x66e4294)  -> save PMGR object
+ *   read     AGXG4P post-GPC-poll `mov w0,#0xa` (0x6695a44) -> dump the six
+ *            clock pages (+0x00/+0x04/+0x08), ps_gfx, the GFX perf-state
+ *            control words and 0x2300c into x1..x28, then fault (far=0xbeef).
+ *
+ * The dump lands in the panic report's x1..x28 (register map in
+ * j96_page5_shell.S); x18 is skipped (Darwin platform register).
+ */
+#include "kpf.h"
+#include <pongo.h>
+#include <xnu/xnu.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+
+extern uint32_t j96_page5_start[], j96_page5_end[];
+extern uint32_t j96_page5_poll_capture[], j96_page5_read[], j96_page5_buffer[];
+
+/* capture signature: 11 words ending at `blr x8` (0x66e4294). */
+static const uint32_t cap_sig[11] = {
+    0x531c6f24,  /* 0x66e426c  lsl w4, w25, #4            */
+    0xf9400288,  /* 0x66e4270  ldr x8, [x20]              */
+    0xf944c908,  /* 0x66e4274  ldr x8, [x8, #0x990]       */
+    0xaa1403e0,  /* 0x66e4278  mov x0, x20                */
+    0xaa1503e1,  /* 0x66e427c  mov x1, x21                */
+    0xaa1703e2,  /* 0x66e4280  mov x2, x23                */
+    0x52801e03,  /* 0x66e4284  mov w3, #0xf0              */
+    0x529dc005,  /* 0x66e4288  mov w5, #0xee00            */
+    0x72a00045,  /* 0x66e428c  movk w5, #2, lsl #16       */
+    0xaa1303e6,  /* 0x66e4290  mov x6, x19                */
+    0xd63f0100,  /* 0x66e4294  blr x8  <- site            */
+};
+#define CAP_LEN 11
+#define CAP_SITE 10
+
+/* read signature: 8 words ending at `mov w0,#0xa` (0x6695a44). */
+static const uint32_t rd_sig[8] = {
+    0x52a80008,  /* 0x6695a2c  mov w8, #0x40000000        */
+    0xb9000008,  /* 0x6695a30  str w8, [x0]               */
+    0x52800228,  /* 0x6695a34  mov w8, #0x11               */
+    0xb9100008,  /* 0x6695a38  str w8, [x0, #0x1000]       */
+    0xb9500008,  /* 0x6695a3c  ldr w8, [x0, #0x1000]       */
+    0x3727ffe8,  /* 0x6695a40  tbnz w8, #4, -0xc           */
+    0x52800140,  /* 0x6695a44  mov w0, #0xa   <- site       */
+    0x9400b3d1,  /* 0x6695a48  bl _IODelay                 */
+};
+#define RD_LEN 8
+#define RD_SITE 6
+
+static struct mach_header_64 *kernel;
+static uint32_t *cap_site;
+static uint32_t *rd_site;
+static uint32_t *my_shellcode;
+static unsigned cap_count, rd_count;
+static bool armed;
+
+static bool f_capture(struct xnu_pf_patch *patch, void *stream) {
+    (void)patch;
+    cap_count++;
+    cap_site = (uint32_t *)stream + CAP_SITE;
+    return true;
+}
+
+static bool f_read(struct xnu_pf_patch *patch, void *stream) {
+    (void)patch;
+    rd_count++;
+    rd_site = (uint32_t *)stream + RD_SITE;
+    return true;
+}
+
+static void capture_p(xnu_pf_patchset_t *set) {
+    uint64_t v[CAP_LEN], m[CAP_LEN];
+    for (unsigned k = 0; k < CAP_LEN; k++) { v[k] = cap_sig[k]; m[k] = 0xffffffff; }
+    xnu_pf_maskmatch(set, "j96_page5_capture", v, m, CAP_LEN, true, f_capture);
+}
+
+static void read_p(xnu_pf_patchset_t *set) {
+    uint64_t v[RD_LEN], m[RD_LEN];
+    for (unsigned k = 0; k < RD_LEN; k++) { v[k] = rd_sig[k]; m[k] = 0xffffffff; }
+    xnu_pf_maskmatch(set, "j96_page5_read", v, m, RD_LEN, true, f_read);
+}
+
+static void init(struct mach_header_64 *hdr, xnu_pf_range_t *cstring,
+                 checkrain_option_t kpf_flags, checkrain_option_t checkra1n_flags) {
+    (void)cstring;
+    (void)kpf_flags;
+    (void)checkra1n_flags;
+    kernel = hdr;
+}
+
+static bool uuid_ok(struct mach_header_64 *h) {
+    static const unsigned char u[] = {
+        0xcc, 0x26, 0xbe, 0x6a, 0x29, 0x2b, 0x37, 0x59,
+        0x9e, 0xd0, 0x29, 0x0b, 0xcf, 0x18, 0xb0, 0x90
+    };
+    uint8_t *p = (uint8_t *)(h + 1);
+    uint8_t *end = p + h->sizeofcmds;
+    for (uint32_t i = 0; i < h->ncmds && (size_t)(end - p) >= sizeof(struct load_command); i++) {
+        struct load_command *c = (struct load_command *)p;
+        if (c->cmdsize < sizeof(*c) || c->cmdsize > (size_t)(end - p))
+            return false;
+        if (c->cmd == LC_UUID && c->cmdsize >= sizeof(struct uuid_command))
+            return !memcmp(((struct uuid_command *)c)->uuid, u, sizeof(u));
+        p += c->cmdsize;
+    }
+    return false;
+}
+
+static bool target_ok(void) {
+    if (!uuid_ok(kernel))
+        return false;
+    if (cap_count != 1 || !cap_site || memcmp(cap_site - CAP_SITE, cap_sig, CAP_LEN * 4))
+        return false;
+    if (rd_count != 1 || !rd_site || memcmp(rd_site - RD_SITE, rd_sig, RD_LEN * 4))
+        return false;
+    return true;
+}
+
+static bool branch(uint32_t *from, uint32_t *to, bool link, uint32_t *out) {
+    int64_t off = (int64_t)(to - from);  /* word difference == VA diff >> 2 */
+    if (off < -0x2000000LL || off > 0x1ffffffLL)  /* +/-128 MiB in words */
+        return false;
+    *out = (link ? 0x94000000U : 0x14000000U) | ((uint32_t)off & 0x03ffffffU);
+    return true;
+}
+
+static uint32_t size(void) {
+    return (uint32_t)(j96_page5_end - j96_page5_start);
+}
+
+static uint32_t emit(uint32_t *area) {
+    my_shellcode = area;
+    if (!target_ok()) {
+        printf("J96_PAGE5_EMIT prepared=0 cap=%u rd=%u\n", cap_count, rd_count);
+        return 0;
+    }
+    memcpy(area, j96_page5_start, (size_t)size() * 4);
+    void *buf = alloc_static(4096);
+    if (!buf) {
+        printf("J96_PAGE5_EMIT alloc_failed\n");
+        return 0;
+    }
+    memset(buf, 0, 4096);
+    uint64_t buf_va = xnu_ptr_to_va(buf);
+    memcpy(area + (j96_page5_buffer - j96_page5_start), &buf_va, 8);
+    armed = true;
+    printf("J96_PAGE5_EMIT prepared=1 words=%u\n", size());
+    return size();
+}
+
+static void finish(struct mach_header_64 *hdr, checkrain_option_t *checkra1n_flags) {
+    (void)checkra1n_flags;
+    uint32_t bc, br;
+    bool ok = armed && target_ok() && my_shellcode && cap_site && rd_site &&
+              branch(cap_site, my_shellcode + (j96_page5_poll_capture - j96_page5_start), true, &bc) &&
+              branch(rd_site,  my_shellcode + (j96_page5_read - j96_page5_start),     true, &br);
+    if (ok) {
+        cap_site[0] = bc;
+        rd_site[0] = br;
+    }
+    printf("J96_PAGE5_PATCH applied=%d\n", ok ? 1 : 0);
+}
+
+kpf_component_t j96_page5_capture = {
+    .init = init,
+    .finish = finish,
+    .shc_size = size,
+    .shc_emit = emit,
+    .patches = {
+        { "com.apple.driver.ApplePMGR", "__TEXT_EXEC", "__text", XNU_PF_ACCESS_32BIT, capture_p },
+        { "com.apple.AGXG4P", "__TEXT_EXEC", "__text", XNU_PF_ACCESS_32BIT, read_p },
+        {}
+    },
+};
diff --git i/checkra1n/kpf/j96_page5_shell.S w/checkra1n/kpf/j96_page5_shell.S
new file mode 100644
index 0000000..f129057
--- /dev/null
+++ w/checkra1n/kpf/j96_page5_shell.S
@@ -0,0 +1,118 @@
+/*
+ * J96 (iPad mini 4, A8/T7000, iPadOS 15.8.3 19H386) FULL-STATE dump probe.
+ * Same two hooks as before, but the read hook now captures the six clock
+ * pages (+0x00/+0x04/+0x08 each), ps_gfx, the GFX perf-state control words
+ * and 0x2300c directly into x1..x28 and faults with far = 0xbeef.
+ *
+ * Direct MMIO read (no function call, so no register clobbering):
+ *   region-0 mapped base VA is at [pmgr + 0xa70]  (regionmap(0,0)->+0x18).
+ *
+ * Register -> value map (read from the panic report's x0..x28):
+ *   x1  = page0 +0x00   x2  = page0 +0x04   x3  = page0 +0x08
+ *   x4  = page1 +0x00   x5  = page1 +0x04   x6  = page1 +0x08
+ *   x7  = page2 +0x00   x10 = page2 +0x04   x11 = page2 +0x08
+ *   x12 = page3 +0x00   x13 = page3 +0x04   x14 = page3 +0x08
+ *   x15 = page4 +0x00   x16 = page4 +0x04   x17 = page4 +0x08
+ *   x19 = page5 +0x00   x20 = page5 +0x04   x21 = page5 +0x08
+ *   x22 = page5 +0x18   x23 = page5 +0x1c   x24 = page5 +0x20
+ *   x25 = ps_gfx  (PMGR +0x20320)
+ *   x26 = +0x1c200 (GFX perf-state control)
+ *   x27 = +0x1c300
+ *   x28 = +0x2300c
+ *   (x18 is skipped: it is the Darwin platform register and the panic dump
+ *    does not show the zero-extended 32-bit value for it.)
+ *   far      = 0xbeef  (dump captured)  /  0xdead  (capture hook never ran)
+ *
+ * READ-ONLY: no MMIO store.
+ */
+    .text
+    .p2align 2
+    .globl _j96_page5_start, _j96_page5_end
+    .globl _j96_page5_poll_capture, _j96_page5_read
+    .globl _j96_page5_buffer
+
+_j96_page5_start:
+
+// --- capture hook (replaces `blr x8` of the ps poll) ------------------------
+// At entry: x20 = PMGR object, x8 = poll fn ptr, x30 = the continuation.
+_j96_page5_poll_capture:
+    stp     x29, x30, [sp, #-16]!
+    ldr     x16, _j96_page5_buffer
+    str     x20, [x16]                  // buffer[0] = PMGR object
+    blr     x8                          // run the original poll
+    ldp     x29, x30, [sp], #16
+    ret
+
+// --- read hook (replaces `mov w0,#0xa` after the GPC busy poll) -------------
+_j96_page5_read:
+    ldr     x16, _j96_page5_buffer
+    ldr     x0, [x16]                   // x0 = saved PMGR object
+    cbz     x0, Lnot_captured
+    ldr     x9, [x0, #0xa70]            // x9 = region-0 mapped base VA
+
+    // page 0 = base + 0x0000
+    mov     x8, x9
+    ldr     w1,  [x8, #0x00]
+    ldr     w2,  [x8, #0x04]
+    ldr     w3,  [x8, #0x08]
+
+    // page 1 = base + 0x1000
+    add     x8, x9, #0x1, lsl #12
+    ldr     w4,  [x8, #0x00]
+    ldr     w5,  [x8, #0x04]
+    ldr     w6,  [x8, #0x08]
+
+    // page 2 = base + 0x2000
+    add     x8, x9, #0x2, lsl #12
+    ldr     w7,  [x8, #0x00]
+    ldr     w10, [x8, #0x04]
+    ldr     w11, [x8, #0x08]
+
+    // page 3 = base + 0x3000
+    add     x8, x9, #0x3, lsl #12
+    ldr     w12, [x8, #0x00]
+    ldr     w13, [x8, #0x04]
+    ldr     w14, [x8, #0x08]
+
+    // page 4 = base + 0x4000
+    add     x8, x9, #0x4, lsl #12
+    ldr     w15, [x8, #0x00]
+    ldr     w16, [x8, #0x04]
+    ldr     w17, [x8, #0x08]
+
+    // page 5 = base + 0x5000
+    add     x8, x9, #0x5, lsl #12
+    ldr     w19, [x8, #0x00]
+    ldr     w20, [x8, #0x04]
+    ldr     w21, [x8, #0x08]
+    ldr     w22, [x8, #0x18]
+    ldr     w23, [x8, #0x1c]
+    ldr     w24, [x8, #0x20]
+
+    // ps_gfx = base + 0x20320
+    add     x8, x9, #0x20, lsl #12
+    ldr     w25, [x8, #0x320]
+
+    // GFX perf-state control = base + 0x1c200, +0x1c300
+    add     x8, x9, #0x1c, lsl #12
+    ldr     w26, [x8, #0x200]
+    ldr     w27, [x8, #0x300]
+
+    // 0x2300c
+    add     x8, x9, #0x23, lsl #12
+    ldr     w28, [x8, #0xc]
+
+    movz    x0, #0xbeef                 // magic: dump captured
+    ldr     x1, [x0]                    // data abort -> far = 0xbeef
+    brk     #0
+
+Lnot_captured:
+    movz    x0, #0xdead                 // magic: capture hook never ran
+    ldr     x1, [x0]                    // data abort -> far = 0xdead
+    brk     #0
+
+    .p2align 3
+_j96_page5_buffer:
+    .quad   0                            // filled by emit() = kernel VA of buffer
+
+_j96_page5_end:
